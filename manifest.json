{
  "manifest_version": 3,
  "name": "SubtitleCurtain — 字幕遮挡器",
  "short_name": "SubtitleCurtain",
  "version": "0.1.0",
  "description": "Cover translated subtitles with a draggable, customizable curtain. Local only; no accounts or servers.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "SubtitleCurtain — Settings",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/core/core.js", "src/extension/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
